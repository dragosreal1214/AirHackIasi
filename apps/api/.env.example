# Copy to `.env` (git-ignored) and fill in. Every var is OPTIONAL:
# leave a section blank and that integration runs in mock/dev mode.

# --- Core ---
ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (Supabase Postgres). EMPTY = in-memory store. ---
# Use the async driver prefix: postgresql+asyncpg://...
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis / Celery (background jobs). EMPTY = disabled. ---
REDIS_URL=

# --- Auth / JWT ---
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Twilio (phone OTP + WhatsApp/SMS notifier). EMPTY = dev OTP "000000". ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# --- Orange CAMARA (Romania): SIM Swap + KYC Match. EMPTY = no signal. ---
# Either set CLIENT_ID + CLIENT_SECRET, OR paste the portal's ready-made
# "Authorization header" value into ORANGE_AUTH_HEADER (e.g. "Basic YUxh...").
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_AUTH_HEADER=
ORANGE_API_BASE=https://api.orange.com
# Orange Network APIs Playground (live). Provision test numbers via the Admin
# API: POST /camara/playground/admin/v1.0/action {"action":"CREATE","phoneNumber":...}
# (Admin uses an /oauth/v3/token token; the CAMARA APIs use the token path below.)
ORANGE_TOKEN_PATH=/openidconnect/playground/v1.0/token
ORANGE_SIM_SWAP_PATH=/camara/playground/api/sim-swap/v1/check
ORANGE_KYC_MATCH_PATH=/camara/playground/api/kyc-match/v0.2/match
# Set true to return canned responses without calling Orange (offline demo).
ORANGE_MOCK=false

# --- External data ---
MAPBOX_TOKEN=
RAPIDAPI_KEY=
