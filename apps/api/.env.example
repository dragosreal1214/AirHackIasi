# --- Core ---
ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (Supabase Postgres, async driver) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aerly

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Twilio (WhatsApp + SMS + Verify) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Orange CAMARA ---
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_API_URL=https://api.orange.com/camara

# --- External data ---
MAPBOX_TOKEN=
RAPIDAPI_KEY=
