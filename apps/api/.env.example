# Copy to `.env` (git-ignored) and fill in. Every var is OPTIONAL:
# leave a section blank and that integration runs in mock/dev mode.

# --- Core ---
ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (Supabase Postgres). EMPTY = in-memory store. ---
# Use the async driver prefix: postgresql+asyncpg://...
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis / Celery (background jobs). EMPTY = disabled. ---
REDIS_URL=

# --- Auth / JWT ---
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Twilio (phone OTP + WhatsApp/SMS notifier). EMPTY = dev OTP "000000". ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# --- Orange CAMARA (Romania): SIM Swap + KYC Match. EMPTY = no signal. ---
# Either set CLIENT_ID + CLIENT_SECRET, OR paste the portal's ready-made
# "Authorization header" value into ORANGE_AUTH_HEADER (e.g. "Basic YUxh...").
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_AUTH_HEADER=
ORANGE_API_BASE=https://api.orange.com
ORANGE_TOKEN_PATH=/oauth/v3/token
# Paths default to the Romania SANDBOX (orange-lab) products. Swap for prod.
ORANGE_SIM_SWAP_PATH=/camara/orange-lab/sim-swap/v1/check
ORANGE_KYC_MATCH_PATH=/camara/orange-lab/kyc-match/v0/match

# --- External data ---
MAPBOX_TOKEN=
RAPIDAPI_KEY=
