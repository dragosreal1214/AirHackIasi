# Fogora web — PUBLIC build-time config (committed on purpose for the MVP).
# Next.js inlines NEXT_PUBLIC_* into the browser bundle, so these are NOT secrets.
# NEVER put backend secrets (Twilio token, DB password, service_role, JWT_SECRET)
# here — those live only on the backend host (Railway), never in the client.

# Deployed backend URL. Empty = the app runs on built-in mock data (clickable
# demo, no backend). Set to your Railway API URL for the real backend.
NEXT_PUBLIC_API_URL=

# Supabase browser client (anon key is public-by-design; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://ptzeweunwdrpzsdtdhvb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB0emV3ZXVud2RycHpzZHRkaHZiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2NzQ3NDIsImV4cCI6MjA5NjI1MDc0Mn0.KP2N4esQGx8nR7SydEDbVeXrC-HenFe6F_8KDA6SvaQ

# Mapbox public token (ops map). Empty = styled fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=
