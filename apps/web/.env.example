# Copy to `.env.local` (git-ignored) and fill in.
# Only NEXT_PUBLIC_* vars are exposed to the browser.

# Leave EMPTY to use the built-in mock data (app works fully offline).
# Set to the running API to use the real backend, e.g. http://localhost:8000
NEXT_PUBLIC_API_URL=

# Supabase (browser client: realtime + auth). Anon key only — never the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public token (ops dashboard map).
NEXT_PUBLIC_MAPBOX_TOKEN=
